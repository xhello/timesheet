# Supabase project: Settings > API (never use the service role key for NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only this VERIFIED email can initialize the admin workspace.
ADMIN_EMAIL=you@example.com

# Set to the final Vercel/custom-domain URL in production; localhost for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
